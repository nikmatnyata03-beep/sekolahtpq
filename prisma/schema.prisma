// PENTING: JANGAN menambahkan `output` pada generator ini — generated client
// perlu di-patch oleh OpenNext agar berjalan di Cloudflare Workers (workerd).
// Lihat serverExternalPackages di next.config.ts.
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ===================== USERS & AUTH =====================

model User {
  id        String         @id @default(cuid())
  email     String         @unique
  name      String
  phone     String?
  password  String
  role      String // ADMIN | GURU | ORANG_TUA
  avatar    String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  teacherProfile Teacher?  @relation(fields: [teacherId], references: [id])
  teacherId      String?   @unique
  students       Student[] @relation("ParentOfStudent")
  notifications  Notification[]
}

// ===================== TEACHERS (Biodata Kemenag-style) =====================

model Teacher {
  id                 String   @id @default(cuid())
  fullName           String
  gender             String // L | P
  birthPlace         String
  birthDate          DateTime
  address            String
  phone              String?
  photoUrl           String?
  formalEducation    String // JSON array [{level,institution,year}]
  nonFormalEducation String? // JSON array
  certifications     String? // JSON array
  expertise          String // keahlian spesifik
  philosophy         String? // filosofi mengajar
  bio                String
  joinDate           DateTime
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user      User?
  classes   Class[]
  materials Material[]
  posts     Post[]
}

// ===================== CLASSES & STUDENTS =====================

model Class {
  id       String  @id @default(cuid())
  name     String // e.g. "Iqra 1", "Al-Qur'an A", "Tahfidz B"
  level    String // IQRA | TAHFIDZ | AL_QURAN | Diniyah
  schedule String
  room     String?
  isActive Boolean @default(true)
  teacherId String?
  teacher  Teacher? @relation(fields: [teacherId], references: [id])

  students   Student[]
  sessions   Session[]
  materials  Material[]
  curricula  Curriculum[]
  createdAt  DateTime     @default(now())
}

model Student {
  id        String   @id @default(cuid())
  nis       String   @unique
  fullName  String
  gender    String // L | P
  birthDate DateTime
  address   String
  status    String   @default("AKTIF") // AKTIF | NONAKTIF | LULUS
  photoUrl  String?
  hafalanTarget String? // target surah Juz 30 yang ditetapkan ustadz, mis. "An-Naba"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parentId String?
  parent   User?   @relation("ParentOfStudent", fields: [parentId], references: [id])

  classId     String?
  class       Class?     @relation(fields: [classId], references: [id])
  attendances Attendance[]
  hafalans    Hafalan[]
  payments    Payment[]
}

// ===================== PPDB REGISTRATION =====================

model Registration {
  id          String   @id @default(cuid())
  regNumber   String   @unique
  childName   String
  gender      String
  birthDate   DateTime
  parentName  String
  phone       String
  email       String?
  address     String
  documents   String // JSON array of uploaded doc names
  note        String?
  status      String   @default("PENDING") // PENDING | VERIFIKASI | DITERIMA | DITOLAK
  reviewNote  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ===================== ATTENDANCE (QR session based) =====================

model Session {
  id        String   @id @default(cuid())
  classId   String
  class     Class    @relation(fields: [classId], references: [id])
  date      DateTime
  topic     String?
  code      String   @unique // check-in code shown as QR
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  // ==== GPS titik absen (Task 33) ====
  // Anchor tempat QR dibuat — check-in santri divalidasi ≤ 20 m dari titik ini.
  lat         Float?
  lng         Float?
  locAccuracy Float?    // akurasi GPS perangkat ustadz (meter)
  locAt       DateTime? // waktu titik diambil (bisa diperbarui ustadz dari dialog QR)

  attendances Attendance[]

  // Task 49: index utk stats harian + laporan bulanan (filter rentang date)
  @@index([date])
}

model Attendance {
  id        String   @id @default(cuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id])
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  status    String // HADIR | IZIN | SAKIT | ALPA
  note      String?
  createdAt DateTime @default(now())

  // ==== GPS + bukti foto (Task 33) ====
  method        String?   // QR_GPS | IZIN_FOTO | SAKIT_FOTO | ALPA_MANUAL | LEGACY
  lat           Float?    // GPS perangkat saat check-in HADIR
  lng           Float?
  accuracy      Float?    // akurasi (meter)
  gpsAt         DateTime? // timestamp posisi klien (dicek freshness ≤ 3 menit)
  distanceM     Float?    // jarak server-computed ke titik absen sesi
  gpsFlags      String?   // JSON hasil heuristik anti-fakeGPS
  proofUrl      String?   // foto surat izin/sakit (R2 → /api/files/...)
  proofLat      Float?    // GPS kamera ustadz saat memotret surat
  proofLng      Float?
  proofAccuracy Float?
  proofAt       DateTime?
  proofGpsFlags String?
  recordedBy    String?   // nama ustadz perekam izin/sakit/alpa
  deviceHash    String?   // Task 42: fingerprint ringan perangkat check-in (anti 1 HP banyak santri)

  @@unique([sessionId, studentId])

  // ==== Task 49: index performa (audit query) ====
  // (status, createdAt)        → panel "Absen Mencurigakan" (scan 30 hari, order desc)
  // (sessionId, status, hash)  → hot path check-in: dup koordinat + dup perangkat
  // (sessionId, createdAt)     → list presensi per sesi (order createdAt desc)
  // (studentId, createdAt)     → riwayat per santri / portal orang tua
  @@index([status, createdAt])
  @@index([sessionId, status, deviceHash])
  @@index([sessionId, createdAt])
  @@index([studentId, createdAt])
}

// ===================== HAFALAN PROGRESS =====================

model Hafalan {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  surahName   String
  ayatRange   String
  type        String   @default("TAHFIDZ") // TAHFIDZ | TAHSHIN | MURAJAAH
  grade       Int? // 0-100
  teacherNote String?
  createdAt   DateTime @default(now())
}

// ===================== TEACHING MATERIALS =====================

model Material {
  id          String   @id @default(cuid())
  title       String
  type        String // PDF | SLIDE | VIDEO | AUDIO
  url         String
  description String?
  category    String // TAJWID | HAFALAN | IBADAH | AKHLAK
  classId     String?
  class       Class?   @relation(fields: [classId], references: [id])
  teacherId   String
  teacher     Teacher  @relation(fields: [teacherId], references: [id])
  createdAt   DateTime @default(now())
}

// ===================== BILLING & PAYMENTS =====================

model Payment {
  id        String    @id @default(cuid())
  invoiceNo String    @unique
  studentId String
  student   Student   @relation(fields: [studentId], references: [id])
  title     String // "Iuran Bulan Ramadhan", "Uang Pangkal"
  amount    Float
  method    String? // QRIS | GOPAY | VA_BCA ...
  status    String    @default("PENDING") // PENDING | SUCCESS | FAILED
  paidAt    DateTime?
  createdAt DateTime  @default(now())
}

// ===================== PUBLIC CONTENT =====================

model Post {
  id         String   @id @default(cuid())
  title      String
  slug       String   @unique
  content    String
  category   String   @default("BERITA") // BERITA | ARTIKEL | KEGIATAN
  coverImage String?
  published  Boolean  @default(false)
  authorId   String?
  author     Teacher? @relation(fields: [authorId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  likes      PostLike[]
  comments   PostComment[]
}

// Task 66 — like ala sosial media: pengunjung publik (tanpa login) ditandai
// visitorId acak di sisi klien; satu pasangan (postId, visitorId) = satu like.
model PostLike {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  visitorId String
  createdAt DateTime @default(now())

  @@unique([postId, visitorId])
}

// Task 67 — komentar ala sosial media: pengunjung publik menulis komentar
// (tanpa login, nama opsional), admin dapat menghapus.
model PostComment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  visitorId String
  name      String   @default("Pengunjung")
  content   String
  createdAt DateTime @default(now())

  @@index([postId, createdAt])
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String
  priority  String   @default("NORMAL") // NORMAL | PENTING
  createdAt DateTime @default(now())
}

model Curriculum {
  id          String @id @default(cuid())
  classId     String?
  class       Class?  @relation(fields: [classId], references: [id])
  level       String // e.g. "Iqra 1-3"
  subject     String // TAJWID | HAFALAN | IBADAH | AKHLAK
  description String
  target      String // capaian pembelajaran
  order       Int     @default(0)
}

// ===================== SITE SETTINGS (Landing Page CMS) =====================

// Key-value store untuk konten landing page yang dapat diedit admin.
// key: hero | about | contact | faqs | testimonials — value: JSON string.
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ===================== WHATSAPP NOTIFICATION LOG =====================

model Notification {
  id        String    @id @default(cuid())
  userId    String?
  user      User?     @relation(fields: [userId], references: [id])
  channel   String    @default("WHATSAPP")
  phone     String
  message   String
  status    String    @default("SENT") // SENT | FAILED
  readAt    DateTime?
  createdAt DateTime  @default(now())
}

// ===================== AI PENTEST & DEVELOPER CONSOLE =====================
// Adaptasi metodologi Strix (usestrix/strix — open-source AI pentest agent):
// temuan ber-severity + PoC + remediation + analisa AI + skor keamanan.

model PentestScan {
  id            String    @id @default(cuid())
  target        String // origin yang dipindai, mis. https://tpq.darussolah.workers.dev
  mode          String    @default("FULL") // QUICK | FULL | CUSTOM
  status        String    @default("RUNNING") // RUNNING | COMPLETED | FAILED
  modules       String // JSON array id modul yang dipilih
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  durationMs    Int?
  criticalCount Int       @default(0)
  highCount     Int       @default(0)
  mediumCount   Int       @default(0)
  lowCount      Int       @default(0)
  infoCount     Int       @default(0)
  score         Int? // 0-100 skor keamanan hasil pemindaian
  aiSummary     String? // ringkasan eksekutif dari AI
  aiPriorities  String? // JSON array langkah prioritas perbaikan
  findings      PentestFinding[]
}

model PentestFinding {
  id          String      @id @default(cuid())
  scanId      String
  scan        PentestScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
  module      String // recon | auth | sqli | xss | idor | headers | info_disclosure | mass_assignment | input_validation | rate_limit | weak_password
  title       String
  severity    String // CRITICAL | HIGH | MEDIUM | LOW | INFO
  target      String // endpoint yang diuji
  method      String? // GET | POST | ...
  description String
  evidence    String? // bukti respons server
  poc         String? // proof-of-concept (gaya Strix)
  remediation String? // langkah perbaikan
  cwe         String? // referensi CWE, mis. CWE-89
  confidence  String? // HIGH | MEDIUM | LOW
  aiAnalysis  String? // analisa mendalam dari AI
  status      String      @default("OPEN") // OPEN | WAITING_AI | FIXED | FALSE_POSITIVE | ACKNOWLEDGED
  linkedIssueId String? // ID DevIssue pada antrean AI Fix Bridge (jika dikirim ke agen AI)
  createdAt   DateTime    @default(now())
}

// Issue kesehatan sistem — terisi otomatis oleh health monitor Dev Console
// (mis. endpoint gagal, respons bukan JSON → "web gagal load json")
// AI FIX BRIDGE: status WAITING_AI = masuk antrean perbaikan oleh agen AI
// eksternal (cron 5 menit: ambil → perbaiki kode → push GitHub → auto-deploy
// → resolve dengan catatan + hash commit).
model DevIssue {
  id          String    @id @default(cuid())
  type        String // ENDPOINT_FAIL | JSON_PARSE | DB_ERROR | PENTEST_CRITICAL | PENTEST_HIGH | RUNTIME_JS | RUNTIME_PROMISE | RUNTIME_FETCH | RUNTIME_HTTP5XX
  endpoint    String?
  message     String
  detail      String?
  status      String    @default("OPEN") // OPEN | WAITING_AI | IN_PROGRESS | DIAGNOSING | FIXED | IGNORED
  source      String    @default("HEALTH") // HEALTH | RUNTIME | PENTEST | MANUAL
  severity    String    @default("MEDIUM") // CRITICAL | HIGH | MEDIUM | LOW | INFO
  aiDiagnosis String? // hasil diagnosa AI / alasan ditolak agen
  aiFix       String? // saran perbaikan / hasil auto-fix / catatan resolusi agen
  claimedAt   DateTime? // waktu agen AI mengambil item antrean
  claimedBy   String? // identitas sesi agen AI yang mengambil
  commitHash  String? // hash commit GitHub perbaikan (auto-deploy Cloudflare)
  fixedAt     DateTime?
  createdAt   DateTime  @default(now())
}

model HealthCheck {
  id        String   @id @default(cuid())
  endpoint  String
  healthy   Boolean
  status    Int? // HTTP status
  latencyMs Int?
  detail    String?
  checkedAt DateTime @default(now())
}

// Riwayat obrolan developer dengan AI (asisten developer in-app)
model DevChat {
  id        String   @id @default(cuid())
  role      String // user | assistant
  content   String
  action    String? // JSON aksi yang dieksekusi AI (jika ada)
  createdAt DateTime @default(now())
}

// ===================== KANTOR AI AGENT 3D (route /kantor) =====================
// Fitur web 3D terisolasi — TIDAK menyentuh data operasional TPQ.

// Manifest aset & data divisi (sumber kebenaran panel 3D; seed via bootstrap)
model Asset {
  id         String   @id @default(cuid())
  kind       String // CHARACTER | OFFICE | PROP
  assetKey   String   @unique // "agent-general-purpose", dst.
  name       String
  division   String? // GENERAL_PURPOSE | EXPLORE | PLAN | FRONTEND | FULLSTACK | PPT | HEAD
  colorHex   String?
  accentHex  String? // warna aksen sekunder (badge, glow)
  modelUrl   String? // null = karakter procedural (dibangun dari primitif)
  animations String? // JSON array, mis. ["idle","walk","talk"]
  role       String? // deskripsi peran divisi
  tasks      String? // JSON array tugas aktif (mock realistis)
  badge      String? // label model AI, mis. "GLM 5.3 Flash"
  status     String   @default("AKTIF")
  tasksDone  Int      @default(0)
  version    Int      @default(1)
  createdAt  DateTime @default(now())
}

// Kritik & saran dari pengunjung web 3D (form saat meja divisi diklik)
model Feedback {
  id         String   @id @default(cuid())
  divisionId String // GENERAL_PURPOSE | ... | HEAD
  name       String?
  message    String
  ip         String?
  createdAt  DateTime @default(now())

  @@index([divisionId, createdAt])
}

// ===================== KANTOR CHAT — ANTRIAN AI (Task 57) =====================
// Chat Head Office asinkron: pesan user disimpan berstatus 'pending', agen
// AI (sandbox, cron 5 menit) mengambil, mengklaim, lalu menjawab via
// /api/kantor/chat/agent (x-agent-key). Protokol: docs/KANTOR-CHAT-AGENT.md

// Satu sesi obrolan per user — terpisah total dari user lain (privasi).
model KantorChatSession {
  id           String   @id @default(cuid())
  userId       String // snapshot pemilik sesi (tidak FK — riwayat tetap ada)
  userRole     String // ADMIN | DEVELOPER (snapshot saat sesi dibuat)
  userName     String
  userEmail    String
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())

  messages KantorChatMessage[]

  @@index([userId, lastActiveAt])
}

// Pesan obrolan. role 'user' → status: pending|processing|answered|error;
// role 'assistant' → status 'done' (isi jawaban / bubble error agen).
model KantorChatMessage {
  id         String    @id @default(cuid())
  sessionId  String
  role       String // 'user' | 'assistant'
  content    String
  status     String    @default("done")
  claimedAt  DateTime? // kapan agen mengklaim (anti balapan antar-sesi cron)
  answeredAt DateTime?
  createdAt  DateTime  @default(now())

  session KantorChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([status, createdAt])
}
