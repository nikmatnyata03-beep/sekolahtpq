{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Nama worker = subdomain: tpq.darussolah.workers.dev
  // main = entry kustom: fetch passthrough OpenNext + scheduled cron harian.
  "name": "tpq",
  "main": "src/worker.ts",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "27f9d19e916a7ab071db7b2ad8f05b94",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Database: Cloudflare D1 (SQLite serverless)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tpqdarussolah",
      "database_id": "27d11454-3a54-44c3-9009-54a4d2befd11"
    }
  ],
  // Storage file upload (foto guru, dll): Cloudflare R2
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "tpqdarussolah-uploads"
    }
  ],
  // Batas CPU Workers Free = 10ms/request: bcrypt cost 10 (~80ms) akan gagal.
  // Cost 5 (~2-3ms) tetap jauh lebih kuat dari plaintext. Upgrade ke Workers
  // Paid ($5/bln, 30s CPU) bila ingin menaikkan nilai ini ke 10-12.
  "vars": {
    "BCRYPT_ROUNDS": "5",
    // Secret untuk memicu /api/cron/daily dari scheduled handler (repo privat;
    // bila repo jadi publik, pindahkan ke Worker Secret via dashboard).
    "CRON_SECRET": "d086576c5cc5541cbb25f28cb8bb438b81461ad6e6fb33dd"
  },
  // Workers AI (tier gratis Â±10rb neuron/hari): ringkasan laporan + asisten guru
  "ai": {
    "binding": "AI"
  },
  // Cron harian 00:00 UTC = 07:00 WIB: pengingat tagihan + auto-tutup sesi lama
  "triggers": {
    "crons": ["0 0 * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "persist": true
    }
  }
}
