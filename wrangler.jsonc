{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Nama worker = subdomain: tpq.darussolah.workers.dev
  // main = entry kustom: fetch passthrough OpenNext + scheduled cron harian.
  "name": "tpq",
  "main": "src/worker.ts",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "27f9d19e916a7ab071db7b2ad8f05b94",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Database: Cloudflare D1 (SQLite serverless)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tpqdarussolah",
      "database_id": "27d11454-3a54-44c3-9009-54a4d2befd11"
    }
  ],
  // Storage file upload (foto guru, dll): Cloudflare R2
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "tpqdarussolah-uploads"
    }
  ],
  // Batas CPU Workers Free = 10ms/request: bcrypt cost 10 (~80ms) akan gagal.
  // Cost 5 (~2-3ms) tetap jauh lebih kuat dari plaintext. Upgrade ke Workers
  // Paid ($5/bln, 30s CPU) bila ingin menaikkan nilai ini ke 10-12.
  "vars": {
    "BCRYPT_ROUNDS": "5",
    // ⚠️ PENTEST 2026-09-12 (KRITIS): repo GitHub ini PUBLIK — kedua nilai di
    // bawah BISA DIBACA SIAPAPUN lewat git history/repo. Nilai lama sudah
    // DIROTASI pada 2026-09-12 agar kunci bocoran mati, TAPI nilai baru juga
    // akan terbaca publik. Langkah permanen WAJIB oleh owner:
    //   1. npx wrangler secret put CRON_SECRET   (nilai dari .env)
    //   2. npx wrangler secret put AGENT_API_KEY (nilai dari .env)
    //   3. HAPUS kedua baris secret ini dari file, commit & push.
    //   (atau set via dashboard Cloudflare → Workers → Settings → Variables)
    "CRON_SECRET": "bdc429063d4c82f557463c71c67d4abe7111b7f2e7d2a803",
    // Lihat peringatan di atas — sama.
    "AGENT_API_KEY": "fe1763beb0649362ce6476bf423660f8c843de2f9864f707"
  },
  // Durable Object "PresenceHub" — panel presensi real-time (WebSocket
  // hibernation). Kelas SQLite-backed → tersedia di tier gratis Workers.
  "durable_objects": {
    "bindings": [
      { "name": "PRESENCE_HUB", "class_name": "PresenceHub" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PresenceHub"] }
  ],
  // Workers AI (tier gratis ±10rb neuron/hari): ringkasan laporan + asisten guru
  "ai": {
    "binding": "AI"
  },
  // Cron harian 00:00 UTC = 07:00 WIB: pengingat tagihan + auto-tutup sesi lama
  "triggers": {
    "crons": ["0 0 * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "persist": true
    }
  }
}
